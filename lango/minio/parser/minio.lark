// MiniO: System O without overloading.  The shared rules are in
// lango/shared/lango.lark.

?stmt: data_decl
     | func_def

func_def: ID pattern* "=" expr ";"

// --- Do blocks ---
?do_stmt: "let" "{" let_binding (";" let_binding)* "}" -> let_block
       | expr

let_binding: ID "=" expr

// --- Expressions (operator precedence from lowest to highest) ---
?expr: "do" "{" stmt_list "}"          -> do_block
     | "if" expr "then" expr "else" expr -> if_else
     | or_expr

?or_expr: or_expr "||" and_expr        -> or_op
        | and_expr

?and_expr: and_expr "&&" comp_expr     -> and_op
         | comp_expr

?comp_expr: comp_expr "==" concat_expr -> eq
          | comp_expr "/=" concat_expr -> neq
          | comp_expr "<" concat_expr  -> lt
          | comp_expr "<=" concat_expr -> lteq
          | comp_expr ">" concat_expr  -> gt
          | comp_expr ">=" concat_expr -> gteq
          | concat_expr

?concat_expr: concat_expr "++" add_expr -> concat
            | add_expr

?add_expr: add_expr "+" mul_expr       -> add
         | add_expr "-" mul_expr       -> sub
         | mul_expr

?mul_expr: mul_expr "*" pow_expr       -> mul
         | mul_expr "/" pow_expr       -> div
         | pow_expr

?pow_expr: unary_expr "^" pow_expr     -> pow_int
         | unary_expr ("^^" | "**") pow_expr -> pow_float
         | unary_expr

?unary_expr: "not" unary_expr          -> not_op
           | "-" unary_expr            -> neg
           | index_expr

?index_expr: index_expr "!!" app_expr  -> index
           | app_expr

?app_expr: app_expr atom_expr          -> app
         | atom_expr

?atom_expr: "(" expr "," expr ("," expr)* ")" -> tuple_literal
          | "(" expr ")"           -> grouped
          | "(" "-" INT ")"        -> neg_int
          | "(" "-" FLOAT ")"      -> neg_float
          | constructor_expr
          | UIDENT                 -> constructor
          | ID                     -> var
          | literal
