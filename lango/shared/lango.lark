// Grammar rules shared by MiniO and System O.  Each language grammar is
// appended to this file (see lango/shared/parser.py) and defines
// `stmt`, `expr`, `app_expr`, `atom_expr`, `func_def` and `do_stmt`.

start: prelude stmt* postlude

prelude: COMMENT*
postlude: COMMENT*

// --- Data Declarations ---
data_decl: "data" TYPE type_param* "=" constructor ("|" constructor)* ";"

type_param: ID

constructor: UIDENT record_constructor
           | UIDENT type_atom*

record_constructor: "{" [field ("," field)*] "}"
field: ID "::" type_expr

// --- Do blocks ---
stmt_list: (do_stmt ";")+

// --- Constructor expressions ---
constructor_expr: UIDENT "{" field_assign ("," field_assign)* "}"
field_assign: ID "=" expr

// --- Types ---
?type_expr: type_app
          | type_app "->" type_expr   -> arrow_type

?type_app: type_app type_atom         -> type_application
         | type_atom

?type_atom: TYPE                      -> type_constructor
          | ID                        -> type_var
          | "(" type_expr ")"         -> grouped_type
          | "(" type_expr "," type_expr ("," type_expr)* ")" -> tuple_type

// --- Patterns ---
?pattern: constructor_pattern
        | cons_pattern
        | tuple_pattern
        | list_pattern
        | UIDENT                 -> constructor_pattern_bare
        | ID                     -> var_pattern
        | atomic_literal         -> literal_pattern
        | "(" "-" INT ")"        -> neg_int_pattern
        | "(" "-" FLOAT ")"      -> neg_float_pattern

constructor_pattern: "(" UIDENT pattern+ ")"
cons_pattern: "(" pattern COLON pattern ")"
tuple_pattern: "(" pattern "," pattern ("," pattern)* ")"
list_pattern: "[" [pattern ("," pattern)*] "]"

// --- Literals ---
?atomic_literal: INT     -> int
               | FLOAT   -> float
               | STRING  -> string
               | CHAR    -> char
               | "True"  -> true
               | "False" -> false

?literal: atomic_literal
        | list

list: "[" [expr ("," expr)*] "]"

// --- Tokens ---
ID: /[a-z][a-zA-Z0-9_]*/
TYPE: /[A-Z][a-zA-Z0-9_]*/
UIDENT: TYPE
STRING: /"[^"]*"/
CHAR: /'[^']*'/
INT: /[0-9]+/
FLOAT: /[0-9]+\.[0-9]+/
COLON: ":"

COMMENT: /--.*/
%ignore COMMENT
%ignore /[ \t]+/
%ignore /\n/

%import common.WS
%ignore WS
