-- Core functions of the SystemO prelude.
--
-- Declarations are scoped sequentially (as in the paper: `inst o : s = e in p`
-- and `let u = e in p`), so everything is defined before it is used.

error x = primError x;

putStr x = primPutStr x;

not True  = False;
not False = True;

-- Operator fixities
infixl 6 +;
infixl 6 -;
infixl 7 *;
infixl 7 /;
infixr 8 **;
infixr 8 ^^;
infixr 8 ^;
infix  4 ==;
infix  4 /=;
infix  4 <;
infix  4 <=;
infix  4 >;
infix  4 >=;
infixr 3 &&;
infixr 2 ||;
infixr 5 ++;
infixl 9 !!;
